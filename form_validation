        showError(email, 'Please enter a valid email address');
        isValid = false;
    } else {
        removeError(email);
    }

    const counrtycode = document.getElementById('country-code');
    if (counrtycode.value.trim() === '') {
        showError(counrtycode, 'counrtycode  is required');
        isValid = false;
    } else {
        removeError(counrtycode);
    }
    
    // Phone validation
    const phone = document.getElementById('registration-phone');
    if (phone.value.trim() === '') {
      showErrorPhone(phone, 'Phone number is required');
        isValid = false;
    } else if (!isValidPhone(phone.value)) {
      showErrorPhone(phone, 'Please enter a valid phone number');
        isValid = false;
    } else {
      removeErrorPhone(phone);
    }
    
    // Password validation
    const password = document.getElementById('registration-password');
    if (password.value.trim() === '') {
        showError(password, 'Password is required');
        isValid = false;
    } else if (password.value.length < 8) {
        showError(password, 'Password must be at least 8 characters long');
        isValid = false;
    } else {
        removeError(password);
    }
    
    // Confirm Password validation
    const confirmPassword = document.getElementById('confirmPassword-registration-password');
    if (confirmPassword.value.trim() === '') {
        showError(confirmPassword, 'Please confirm your password');
        isValid = false;
    } else if (confirmPassword.value !== password.value) {
        showError(confirmPassword, 'Passwords do not match');
        isValid = false;
    } else {
        removeError(confirmPassword);
    }
    
    // Date of Birth validation
    const dateOfBirth = document.getElementById('dateofbirth');
    if (dateOfBirth.value.trim() === '') {
        showError(dateOfBirth, 'Date of birth is required');
        isValid = false;
    } else {
        removeError(dateOfBirth);
    }
    
    // Gender validation
    const gender = document.getElementById('gender');
    if (gender.value === '') {
        showError(gender, 'Please select a gender');
        isValid = false;
    } else {
        removeError(gender);
    }
    
    // Residence Country validation
    const residenceCountry = document.getElementById('residence-country');
    if (residenceCountry.value === '') {
        showError(residenceCountry, 'Please select your residence country');
        isValid = false;
    } else {
        removeError(residenceCountry);
    }
    
    // City validation
    const city = document.getElementById('city');
    if (city.value.trim() === '') {
        showError(city, 'City is required');
        isValid = false;
    } else {
        removeError(city);
    }
    
    return isValid;
}

function showError(input, message) {
    const formGroup = input.closest('.form-group');
    const errorElement = formGroup.querySelector('.error-message') || document.createElement('div');
    errorElement.className = 'error-message text-danger';
    errorElement.textContent = message;
    if (!formGroup.querySelector('.error-message')) {
        formGroup.appendChild(errorElement);
    }
    input.classList.add('is-invalid');
}

function removeError(input) {
    const formGroup = input.closest('.form-group');
    const errorElement = formGroup.querySelector('.error-message');
    if (errorElement) {
        formGroup.removeChild(errorElement);
    }
    input.classList.remove('is-invalid');
}

function isValidEmail(email) {
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(String(email).toLowerCase());
}

function isValidPhone(phone) {
    // This is a basic check. You might want to use a more sophisticated validation
    // or integrate it with the intl-tel-input validation
    const re = /^\+?[\d\s-]{10,}$/;
    return re.test(phone);
}

